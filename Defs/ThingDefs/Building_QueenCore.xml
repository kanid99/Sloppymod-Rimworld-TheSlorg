	<ThingDef ParentName="BuildingBase">
		<defName>Slorg_Conduit</defName>
		<label>hive conduit</label>
		<description>A pillar of cabling and transceivers carrying the collective's signal through the Unicomplex.</description>
		<graphicData>
			<texPath>Things/Building/Slorg_Conduit</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<altitudeLayer>Building</altitudeLayer>
		<rotatable>false</rotatable>
		<passability>Impassable</passability>
		<fillPercent>0.6</fillPercent>
		<statBases>
			<MaxHitPoints>200</MaxHitPoints>
