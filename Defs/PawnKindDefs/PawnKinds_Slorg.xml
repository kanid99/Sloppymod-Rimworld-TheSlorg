<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<PawnKindDef Name="Slorg_KindBase" Abstract="True">
		<race>Human</race>
		<defaultFactionType>Slorg_CollectiveFaction</defaultFactionType>
		<useFactionXenotypes>false</useFactionXenotypes>
		<xenotypeSet>
			<xenotypeChances>
				<Slorg_Drone>1</Slorg_Drone>
			</xenotypeChances>
		</xenotypeSet>
		<chemicalAddictionChance>0</chemicalAddictionChance>
		<backstoryCryptosleepCommonality>0</backstoryCryptosleepCommonality>
		<invNutrition>0</invNutrition>
		<minGenerationAge>18</minGenerationAge>
		<maxGenerationAge>60</maxGenerationAge>
		<apparelAllowHeadgearChance>0</apparelAllowHeadgearChance>
		<apparelMoney>0~0</apparelMoney>
		<weaponMoney>0~0</weaponMoney>
		<!-- Drones can't be talked round. Freeing one takes surgery. -->
		<initialResistanceRange>60~90</initialResistanceRange>
		<initialWillRange>6~10</initialWillRange>
	</PawnKindDef>

	<PawnKindDef ParentName="Slorg_KindBase">
		<defName>Slorg_DroneKind</defName>
		<label>slorg drone</label>
		<combatPower>90</combatPower>
		<skills>
			<li>
				<skill>Melee</skill>
				<range>6~12</range>
			</li>
		</skills>
			<modExtensions>
			<li Class="TheSlorg.SlorgImplantSetExtension">
				<implants>
					<li>
						<hediff>Slorg_DermalPlating</hediff>
					</li>
					<li>
						<hediff>Slorg_OcularImplant</hediff>
						<part>Eye</part>
					</li>
					<li>
						<hediff>Slorg_AssimilationTubules</hediff>
						<part>Hand</part>
					</li>
					<li>
						<hediff>Slorg_ArmBlade</hediff>
						<part>Arm</part>
					</li>
					<li>
						<hediff>Slorg_ShieldEmitter</hediff>
						<part>Torso</part>
						<chance>0.3</chance>
					</li>
					<li>
						<hediff>Slorg_TacticalCortex</hediff>
						<part>Brain</part>
						<chance>0.3</chance>
					</li>
				</implants>
			</li>
		</modExtensions>
	</PawnKindDef>

	<PawnKindDef ParentName="Slorg_KindBase">
		<defName>Slorg_TacticalDroneKind</defName>
		<label>tactical drone</label>
		<combatPower>140</combatPower>
		<skills>
			<li>
				<skill>Shooting</skill>
				<range>6~12</range>
			</li>
		</skills>
			<modExtensions>
			<li Class="TheSlorg.SlorgImplantSetExtension">
				<implants>
					<li>
						<hediff>Slorg_DermalPlating</hediff>
					</li>
					<li>
						<hediff>Slorg_OcularImplant</hediff>
						<part>Eye</part>
					</li>
					<li>
						<hediff>Slorg_ShieldEmitter</hediff>
						<part>Torso</part>
					</li>
					<li>
						<hediff>Slorg_BeamEmitter</hediff>
						<part>Arm</part>
					</li>
					<li>
						<hediff>Slorg_TacticalCortex</hediff>
						<part>Brain</part>
						<chance>0.6</chance>
					</li>
					<li>
						<hediff>Slorg_AssimilationTubules</hediff>
						<part>Hand</part>
						<chance>0.5</chance>
					</li>
				</implants>
			</li>
		</modExtensions>
	</PawnKindDef>

	<PawnKindDef ParentName="Slorg_KindBase">
		<defName>Slorg_QueenKind</defName>
		<label>slorg queen</label>
		<combatPower>600</combatPower>
		<factionLeader>true</factionLeader>
		<fixedGender>Female</fixedGender>
		<minGenerationAge>25</minGenerationAge>
		<xenotypeSet Inherit="False">
			<xenotypeChances>
				<Slorg_Queen>1</Slorg_Queen>
			</xenotypeChances>
		</xenotypeSet>
		<apparelAllowHeadgearChance>0</apparelAllowHeadgearChance>
		<initialResistanceRange>150~200</initialResistanceRange>
		<skills>
			<li>
				<skill>Shooting</skill>
				<range>12~18</range>
			</li>
			<li>
				<skill>Melee</skill>
				<range>12~18</range>
			</li>
		</skills>
			<modExtensions>
			<li Class="TheSlorg.SlorgImplantSetExtension">
				<implants>
					<li>
						<hediff>Slorg_DermalPlating</hediff>
					</li>
					<li>
						<hediff>Slorg_OcularImplant</hediff>
						<part>Eye</part>
					</li>
					<li>
						<hediff>Slorg_ShieldEmitter</hediff>
						<part>Torso</part>
					</li>
					<li>
						<hediff>Slorg_BeamEmitter</hediff>
						<part>Arm</part>
					</li>
					<li>
						<hediff>Slorg_ArmBlade</hediff>
						<part>Arm</part>
					</li>
					<li>
						<hediff>Slorg_AssimilationTubules</hediff>
						<part>Hand</part>
					</li>
					<li>
						<hediff>Slorg_TacticalCortex</hediff>
						<part>Brain</part>
					</li>
					<li>
						<hediff>Slorg_ControlImplant</hediff>
						<part>Brain</part>
					</li>
				</implants>
			</li>
		</modExtensions>
	</PawnKindDef>

</Defs>
