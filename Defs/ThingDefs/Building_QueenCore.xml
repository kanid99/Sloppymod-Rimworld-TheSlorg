	<ThingDef ParentName="BodyPartBase">
		<defName>Slorg_ControlImplantItem</defName>
		<label>control implant</label>
		<description>A queen's command node, extracted intact. Install it by surgery, or have a pawn use it to implant it in themselves. The carrier can then trace the Slorg hive signal back to the Unicomplex and its queen core.\n\nAnyone but a freed queen who carries it risks hearing the collective's call.</description>
		<descriptionHyperlinks>
			<HediffDef>Slorg_ControlImplant</HediffDef>
		</descriptionHyperlinks>
		<graphicData>
			<texPath>Things/Item/Slorg_ControlImplant</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<techLevel>Spacer</techLevel>
		<isTechHediff>true</isTechHediff>
		<comps>
			<li Class="CompProperties_Usable">
				<useJob>UseItem</useJob>
				<useLabel>Implant control implant</useLabel>
				<useDuration>600</useDuration>
			</li>
			<li Class="CompProperties_UseEffectInstallImplant">
				<hediffDef>Slorg_ControlImplant</hediffDef>
				<bodyPart>Brain</bodyPart>
			</li>
			<li Class="CompProperties_UseEffectDestroySelf" />
		</comps>
		<statBases>
			<MarketValue>2500</MarketValue>
			<Mass>0.3</Mass>
			<DeteriorationRate>0</DeteriorationRate>
		</statBases>
	</ThingDef>

</Defs>
