<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!-- Assimilation. Severity rises 4-6 per day, so it completes in about 4-6 hours untended.
	     While tended it rises 3/day slower (about 1-3/day), buying time.
	     A tend above 100% quality (glitterworld medicine) cures it at any stage.
	     Stage 1 (below stage2Severity, ~1.5-2 hours): the host fights for the Slorg; any tend of 50%+ cures it.
	     Stage 2: implants and Slorg genes form; only the Purge nanoprobes surgery cures it.
	     Complete: full drone, no cure. Bleeding is stopped throughout. -->
	<HediffDef>
		<defName>Slorg_NanoprobeInfection</defName>
		<label>nanoprobe infection</label>
		<description>Slorg nanoprobes are taking this person over. First they seize the nervous system, then they grow implants and rewrite the genes. When they finish, the host is a Slorg drone.\n\nWhile it spreads, the nanoprobes seal wounds so the host doesn't bleed out.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<defaultLabelColor>(0.55, 0.95, 0.55)</defaultLabelColor>
		<isBad>true</isBad>
		<tendable>true</tendable>
		<everCurableByItem>false</everCurableByItem>
		<initialSeverity>0.01</initialSeverity>
		<maxSeverity>1</maxSeverity>
		<comps>
			<li Class="HediffCompProperties_TendDuration">
				<baseTendDurationHours>4</baseTendDurationHours>
				<severityPerDayTended>-3</severityPerDayTended>
			</li>
			<li Class="HediffCompProperties_SeverityPerDay">
				<severityPerDayRange>4~6</severityPerDayRange>
			</li>
			<li Class="TheSlorg.HediffCompProperties_NanoprobeInfection">
				<stage2Severity>0.35</stage2Severity>
				<stage1CureTendQuality>0.5</stage1CureTendQuality>
				<!-- Above 100% quality: only glitterworld medicine gets there. Cures at any stage. -->
				<anyStageCureTendQuality>1.01</anyStageCureTendQuality>
				<stage2Genes>
					<li>Slorg_CollectiveLink</li>
					<li>Slorg_Nanoprobes</li>
					<li>Slorg_DroneConditioning</li>
					<li>Slorg_DroneSkin</li>
				</stage2Genes>
				<stage2Implants>
					<li>
						<hediff>Slorg_OcularImplant</hediff>
						<part>Eye</part>
					</li>
					<li>
						<hediff>Slorg_DermalPlating</hediff>
					</li>
				</stage2Implants>
			</li>
		</comps>
		<stages>
			<li>
				<label>neural takeover</label>
				<totalBleedFactor>0</totalBleedFactor>
				<painOffset>0.05</painOffset>
			</li>
			<li>
				<minSeverity>0.35</minSeverity>
				<label>implants forming</label>
				<totalBleedFactor>0</totalBleedFactor>
				<painOffset>0.10</painOffset>
			</li>
			<li>
				<minSeverity>0.8</minSeverity>
				<label>almost assimilated</label>
				<totalBleedFactor>0</totalBleedFactor>
				<painOffset>0.10</painOffset>
			</li>
		</stages>
	</HediffDef>

	<!-- Neural shock from Slorg weapons. Builds up with each hit and wears off; it downs, it doesn't kill. -->
	<HediffDef>
		<defName>Slorg_NeuralDisruption</defName>
		<label>neural shock</label>
		<description>Slorg weapons overload the nervous system instead of tearing flesh. Enough of it and the victim collapses, ready to be assimilated. It fades on its own.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<defaultLabelColor>(0.5, 0.9, 1.0)</defaultLabelColor>
		<isBad>true</isBad>
		<maxSeverity>100</maxSeverity>
		<comps>
			<li Class="HediffCompProperties_SeverityPerDay">
				<severityPerDay>-240</severityPerDay>
			</li>
		</comps>
		<stages>
			<li>
				<label>tingling</label>
				<painOffset>0.10</painOffset>
			</li>
			<li>
				<minSeverity>25</minSeverity>
				<label>disrupted</label>
				<painOffset>0.20</painOffset>
				<capMods>
					<li>
						<capacity>Consciousness</capacity>
						<offset>-0.15</offset>
					</li>
					<li>
						<capacity>Moving</capacity>
						<offset>-0.15</offset>
					</li>
				</capMods>
			</li>
			<li>
				<minSeverity>50</minSeverity>
				<label>severe</label>
				<painOffset>0.30</painOffset>
				<capMods>
					<li>
						<capacity>Consciousness</capacity>
						<offset>-0.35</offset>
					</li>
					<li>
						<capacity>Moving</capacity>
						<offset>-0.30</offset>
					</li>
				</capMods>
			</li>
			<li>
				<minSeverity>75</minSeverity>
				<label>collapsed</label>
				<capMods>
					<li>
						<capacity>Consciousness</capacity>
						<setMax>0.1</setMax>
					</li>
				</capMods>
			</li>
		</stages>
	</HediffDef>

	<!-- A drone summoned by a captive queen. Serves the colony only while she stays captive. -->
	<HediffDef>
		<defName>Slorg_QueenBound</defName>
		<label>bound to queen</label>
		<description>This drone answered a captive queen's call. It serves the colony through her, and it has no will of its own to break. If she ever gets free, it will answer her again.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<defaultLabelColor>(0.8, 0.6, 1.0)</defaultLabelColor>
		<isBad>false</isBad>
		<everCurableByItem>false</everCurableByItem>
		<comps>
			<li Class="TheSlorg.HediffCompProperties_QueenBound" />
		</comps>
	</HediffDef>

	<!-- A captive queen's suppression (0-1). Drains ~0.25/day; wardens raise it. Low values let her drones
	     secretly seed sleeper agents. Tuning in Slorg_Collective.xml. -->
	<HediffDef>
		<defName>Slorg_QueenSuppression</defName>
		<label>queen suppression</label>
		<description>How firmly the colony holds this queen's will. Wardens have to suppress her regularly. If it slips, the drones she called start working for her again in secret, quietly seeding nanoprobes through the colony.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<defaultLabelColor>(0.8, 0.6, 1.0)</defaultLabelColor>
		<isBad>false</isBad>
		<everCurableByItem>false</everCurableByItem>
		<alwaysShowSeverity>true</alwaysShowSeverity>
		<initialSeverity>0.5</initialSeverity>
		<minSeverity>0.001</minSeverity>
		<maxSeverity>1</maxSeverity>
		<comps>
			<li Class="HediffCompProperties_SeverityPerDay">
				<severityPerDay>-0.25</severityPerDay>
			</li>
		</comps>
		<stages>
			<li>
				<label>defiant</label>
			</li>
			<li>
				<minSeverity>0.3</minSeverity>
				<label>restless</label>
			</li>
			<li>
				<minSeverity>0.5</minSeverity>
				<label>suppressed</label>
			</li>
		</stages>
	</HediffDef>

	<DamageDef>
		<defName>Slorg_NeuralShock</defName>
		<label>neural shock</label>
		<workerClass>TheSlorg.DamageWorker_SlorgNeural</workerClass>
		<hediff>Slorg_NeuralDisruption</hediff>
		<externalViolence>true</externalViolence>
		<harmsHealth>true</harmsHealth>
		<makesBlood>false</makesBlood>
		<deathMessage>{0} has died of neural shock.</deathMessage>
	</DamageDef>

	<!-- A drone cut off from the collective: its queen fell nearby, its queen core was destroyed, or it was just freed. -->
	<HediffDef>
		<defName>Slorg_Severance</defName>
		<label>severed from collective</label>
		<description>The collective has gone silent. This drone has collapsed, unable to act without the voices it has always heard.\n\nWhile severed, a drone can be given the Sever link surgery to cut it from the collective for good. When the severance wears off, a drone that still has its link reconnects.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<defaultLabelColor>(0.7, 0.7, 0.7)</defaultLabelColor>
		<isBad>true</isBad>
		<everCurableByItem>false</everCurableByItem>
		<comps>
			<li Class="HediffCompProperties_Disappears">
				<disappearsAfterTicks>100000~140000</disappearsAfterTicks>
				<showRemainingTime>true</showRemainingTime>
			</li>
		</comps>
		<stages>
			<li>
				<capMods>
					<li>
						<capacity>Consciousness</capacity>
						<setMax>0.1</setMax>
					</li>
				</capMods>
			</li>
		</stages>
	</HediffDef>

	<!-- Hidden sleeper agent. The stage never becomes visible, so it doesn't show on the health tab.
	     Only the nanoprobe scan surgery finds it. Behavior lives in SleeperUtility. -->
	<HediffDef>
		<defName>Slorg_DormantNanoprobes</defName>
		<label>dormant nanoprobes</label>
		<description>Slorg nanoprobes lying low in the bloodstream. The carrier seems perfectly healthy, but they now quietly serve the collective.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<isBad>false</isBad>
		<everCurableByItem>false</everCurableByItem>
		<comps>
			<li Class="TheSlorg.HediffCompProperties_DormantNanoprobes" />
		</comps>
		<stages>
			<li>
				<becomeVisible>false</becomeVisible>
			</li>
		</stages>
	</HediffDef>

</Defs>
