<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<RecipeDef ParentName="SurgeryFlesh">
		<defName>Slorg_SeverLink</defName>
		<label>sever collective link</label>
		<description>Cut a severed Slorg drone's transceiver out of their brainstem, freeing them from the collective for good. They become a disconnected drone.\n\nOnly possible while the drone is severed from the collective, for example in the days after their queen falls.</description>
		<workerClass>TheSlorg.Recipe_SeverLink</workerClass>
		<jobString>Severing collective link.</jobString>
		<workAmount>4000</workAmount>
		<targetsBodyPart>false</targetsBodyPart>
		<hideBodyPartNames>true</hideBodyPartNames>
		<surgerySuccessChanceFactor>0.8</surgerySuccessChanceFactor>
		<researchPrerequisite>Slorg_NeuralSeverance</researchPrerequisite>
		<skillRequirements>
			<Medicine>10</Medicine>
		</skillRequirements>
		<recipeUsers>
			<li>Human</li>
		</recipeUsers>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>MedicineUltratech</li>
					</thingDefs>
				</filter>
				<count>2</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>MedicineUltratech</li>
			</thingDefs>
		</fixedIngredientFilter>
	</RecipeDef>

	<RecipeDef ParentName="SurgeryFlesh">
		<defName>Slorg_NanoprobeScan</defName>
		<label>nanoprobe scan</label>
		<description>Flush the patient's blood through glitterworld medicine and look for dormant Slorg nanoprobes. If any are found they are purged, and a hidden sleeper agent is freed.</description>
		<workerClass>TheSlorg.Recipe_NanoprobeScan</workerClass>
		<jobString>Scanning for nanoprobes.</jobString>
		<workAmount>1500</workAmount>
		<targetsBodyPart>false</targetsBodyPart>
		<hideBodyPartNames>true</hideBodyPartNames>
		<anesthetize>false</anesthetize>
		<surgerySuccessChanceFactor>1.2</surgerySuccessChanceFactor>
		<researchPrerequisite>Slorg_NanoprobeDetection</researchPrerequisite>
		<skillRequirements>
			<Medicine>6</Medicine>
		</skillRequirements>
		<recipeUsers>
			<li>Human</li>
		</recipeUsers>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>MedicineUltratech</li>
					</thingDefs>
				</filter>
				<count>1</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>MedicineUltratech</li>
			</thingDefs>
		</fixedIngredientFilter>
	</RecipeDef>


	<RecipeDef ParentName="SurgeryFlesh">
		<defName>Slorg_PurgeNanoprobes</defName>
		<label>purge nanoprobes</label>
		<description>Flush a nanoprobe infection out of the patient before assimilation completes. Any Slorg genes the nanoprobes wrote are stripped out, but implants they already grew stay and must be cut out separately.\n\nOnce assimilation is complete, this no longer works.</description>
		<workerClass>TheSlorg.Recipe_PurgeNanoprobes</workerClass>
		<jobString>Purging nanoprobes.</jobString>
		<workAmount>1200</workAmount>
		<targetsBodyPart>false</targetsBodyPart>
		<hideBodyPartNames>true</hideBodyPartNames>
		<surgerySuccessChanceFactor>1.1</surgerySuccessChanceFactor>
		<skillRequirements>
			<Medicine>8</Medicine>
		</skillRequirements>
		<recipeUsers>
			<li>Human</li>
		</recipeUsers>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>MedicineUltratech</li>
					</thingDefs>
				</filter>
				<count>1</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>MedicineUltratech</li>
			</thingDefs>
		</fixedIngredientFilter>
	</RecipeDef>

	<!-- Slorg implant removal. Always destroys the implant and injures the patient. -->
	<RecipeDef Name="Slorg_RemoveImplantBase" ParentName="SurgeryFlesh" Abstract="True">
		<workerClass>TheSlorg.Recipe_RemoveSlorgImplant</workerClass>
		<targetsBodyPart>false</targetsBodyPart>
		<hideBodyPartNames>true</hideBodyPartNames>
		<workAmount>3000</workAmount>
		<recipeUsers>
			<li>Human</li>
		</recipeUsers>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>MedicineIndustrial</li>
					</thingDefs>
				</filter>
				<count>2</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>MedicineIndustrial</li>
			</thingDefs>
		</fixedIngredientFilter>
	</RecipeDef>

	<RecipeDef ParentName="Slorg_RemoveImplantBase">
		<defName>Slorg_RemoveOcularImplant</defName>
		<label>cut out ocular implant</label>
		<description>Cut the Slorg ocular implant out of the patient. The implant is destroyed, and the patient will be badly hurt.</description>
		<jobString>Cutting out ocular implant.</jobString>
		<removesHediff>Slorg_OcularImplant</removesHediff>
		<skillRequirements>
			<Medicine>6</Medicine>
		</skillRequirements>
	</RecipeDef>

