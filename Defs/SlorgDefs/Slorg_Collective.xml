<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!-- Tuning for the collective. Only the listed trait + degree pairs can spread between drones. -->
	<TheSlorg.SlorgCollectiveDef>
		<defName>Slorg_Collective</defName>
		<label>slorg collective</label>
		<refreshIntervalTicks>500</refreshIntervalTicks>
		<!-- A queen on the map counts as this many extra drones for the collective link stages. -->
		<queenPresenceBonusDrones>10</queenPresenceBonusDrones>
		<!-- Raids of at least this many points have this chance to bring the queen. -->
		<queenRaidMinPoints>5000</queenRaidMinPoints>
		<queenRaidChance>0.5</queenRaidChance>
		<unicomplexName>Unicomplex</unicomplexName>

		<!-- Sleeper agents: chance a "purged" infection goes dormant, incubation, and time between injections. -->
		<dormantChanceOnPurge>0.4</dormantChanceOnPurge>
		<!-- A prisoner or slave who succumbs: this chance to become a hidden sleeper, otherwise they break out hostile. -->
		<captiveSleeperChance>0.5</captiveSleeperChance>
		<sleeperIncubationTicks>60000</sleeperIncubationTicks>
		<sleeperInjectIntervalDays>0.5~1.5</sleeperInjectIntervalDays>
		<witnessChanceObserved>0.6</witnessChanceObserved>
		<witnessChanceUnobserved>0.1</witnessChanceUnobserved>
		<!-- Uprising once sleepers >= min and >= this share of free colonists. -->
		<uprisingMinSleepers>3</uprisingMinSleepers>
		<uprisingColonistFraction>0.34</uprisingColonistFraction>
		<!-- Chance the collective raids to back up an uprising, delay in ticks, and raid size vs a normal big threat. -->
		<uprisingRaidChance>0.5</uprisingRaidChance>
		<uprisingRaidDelayTicks>2500</uprisingRaidDelayTicks>
		<uprisingRaidPointsFactor>0.7</uprisingRaidPointsFactor>
		<!-- A captive queen can call a drone every this many days, up to this many at once. -->
		<captiveQueenSummonCooldownDays>3</captiveQueenSummonCooldownDays>
		<captiveQueenMaxDrones>6</captiveQueenMaxDrones>

		<!-- Captive queen suppression (0-1). Drain rate is on the Slorg_QueenSuppression hediff. -->
		<queenSuppressionStart>0.5</queenSuppressionStart>
		<queenSuppressionPerSession>0.15</queenSuppressionPerSession>
		<queenSuppressionPerSocialLevel>0.015</queenSuppressionPerSocialLevel>
		<queenSuppressionWorkBelow>0.8</queenSuppressionWorkBelow>
		<queenSuppressionToSummon>0.5</queenSuppressionToSummon>
		<queenSuppressionDangerLevel>0.3</queenSuppressionDangerLevel>
		<!-- Mean days between hidden infections by her drones: just under the danger level, and at zero. -->
		<queenSeedingMtbDaysAtDanger>3</queenSeedingMtbDaysAtDanger>
		<queenSeedingMtbDaysAtZero>0.5</queenSeedingMtbDaysAtZero>

		<!-- Linked nanoprobes cure these (plus anything the game marks chronic). -->
		<nanoprobeCures>
			<li>Alzheimers</li>
			<li>Dementia</li>
			<li>Cataract</li>
			<li>BadBack</li>
			<li>Frail</li>
			<li>HeartArteryBlockage</li>
			<li>Asthma</li>
			<li>Carcinoma</li>
		</nanoprobeCures>
		<shareableTraits>
			<li><def>Industriousness</def><degree>1</degree></li>  <!-- industrious -->
			<li><def>Industriousness</def><degree>2</degree></li>  <!-- hard worker -->
			<li><def>Tough</def><degree>0</degree></li>
			<li><def>Nimble</def><degree>0</degree></li>
			<li><def>ShootingAccuracy</def><degree>1</degree></li> <!-- careful shooter -->
			<li><def>FastLearner</def><degree>0</degree></li>
			<li><def>GreatMemory</def><degree>0</degree></li>
			<li><def>QuickSleeper</def><degree>0</degree></li>
			<li><def>SpeedOffset</def><degree>1</degree></li>      <!-- fast walker -->
			<li><def>SpeedOffset</def><degree>2</degree></li>      <!-- jogger -->
			<li><def>Nerves</def><degree>1</degree></li>           <!-- steadfast -->
			<li><def>Nerves</def><degree>2</degree></li>           <!-- iron-willed -->
		</shareableTraits>
	</TheSlorg.SlorgCollectiveDef>

</Defs>
