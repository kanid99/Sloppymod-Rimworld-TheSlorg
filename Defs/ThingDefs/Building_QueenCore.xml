<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<ThingDef ParentName="BuildingBase">
		<defName>Slorg_QueenCore</defName>
		<label>queen core</label>
		<description>A humming lattice of processors and nanoprobe vats at the centre of the Unicomplex. The queen core binds every Slorg drone on this world to the collective and grows the next queen when the last one falls.\n\nDestroy it and every drone on the surface is permanently disconnected.</description>
		<thingClass>TheSlorg.Building_QueenCore</thingClass>
		<graphicData>
			<texPath>Things/Building/Slorg_QueenCore</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(3,3)</drawSize>
		</graphicData>
		<size>(3,3)</size>
		<altitudeLayer>Building</altitudeLayer>
		<passability>Impassable</passability>
		<blockWind>true</blockWind>
		<fillPercent>1</fillPercent>
		<castEdgeShadows>true</castEdgeShadows>
		<rotatable>false</rotatable>
		<useHitPoints>true</useHitPoints>
		<leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
		<statBases>
			<MaxHitPoints>4000</MaxHitPoints>
			<Flammability>0</Flammability>
			<Beauty>-10</Beauty>
		</statBases>
		<building>
			<claimable>false</claimable>
			<deconstructible>false</deconstructible>
		</building>
		<killedLeavings>
			<ComponentSpacer>6</ComponentSpacer>
			<Plasteel>60</Plasteel>
		</killedLeavings>
		<comps>
			<li Class="CompProperties_Glower">
				<glowRadius>9</glowRadius>
				<glowColor>(80,220,100,0)</glowColor>
			</li>
		</comps>
	</ThingDef>

	<ThingDef ParentName="BuildingBase">
		<defName>Slorg_DisruptorTurret</defName>
		<label>disruptor turret</label>
		<description>A Slorg defence node that fires neural disruptor bolts. It downs intruders for the drones to collect.</description>
		<thingClass>Building_TurretGun</thingClass>
		<drawerType>MapMeshAndRealTime</drawerType>
		<graphicData>
			<texPath>Things/Building/Slorg_TurretBase</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(2,2)</drawSize>
			<damageData>
				<rect>(0.2,0.2,1.6,1.6)</rect>
			</damageData>
		</graphicData>
		<uiIconPath>Things/Building/Slorg_DisruptorTurret_Top</uiIconPath>
		<size>(2,2)</size>
		<altitudeLayer>Building</altitudeLayer>
		<stealable>false</stealable>
		<rotatable>false</rotatable>
		<tickerType>Normal</tickerType>
		<passability>PassThroughOnly</passability>
		<pathCost>50</pathCost>
		<fillPercent>0.5</fillPercent>
		<hasTooltip>true</hasTooltip>
		<statBases>
			<MaxHitPoints>450</MaxHitPoints>
			<Flammability>0</Flammability>
			<Beauty>-10</Beauty>
			<ShootingAccuracyTurret>0.9</ShootingAccuracyTurret>
		</statBases>
		<comps>
			<li Class="CompProperties_Explosive">
				<wickTicks>180</wickTicks>
				<explosiveRadius>3.9</explosiveRadius>
				<explosiveDamageType>Bomb</explosiveDamageType>
				<chanceNeverExplodeFromDamage>0.5</chanceNeverExplodeFromDamage>
			</li>
			<li Class="CompProperties_Glower">
				<glowRadius>4</glowRadius>
				<glowColor>(80,220,100,0)</glowColor>
			</li>
		</comps>
		<building>
			<combatPower>90</combatPower>
			<ai_combatDangerous>true</ai_combatDangerous>
			<turretGunDef>Slorg_Gun_DisruptorTurret</turretGunDef>
			<turretBurstCooldownTime>2.5</turretBurstCooldownTime>
			<turretTopDrawSize>2</turretTopDrawSize>
			<deconstructible>false</deconstructible>
			<claimable>false</claimable>
		</building>
	</ThingDef>

	<ThingDef ParentName="BaseWeaponTurret">
		<defName>Slorg_Gun_DisruptorTurret</defName>
		<label>disruptor turret emitter</label>
		<description>The emitter of a disruptor turret.</description>
		<graphicData>
			<texPath>Things/Building/Slorg_DisruptorTurret_Top</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<AccuracyTouch>0.7</AccuracyTouch>
			<AccuracyShort>0.75</AccuracyShort>
			<AccuracyMedium>0.7</AccuracyMedium>
			<AccuracyLong>0.6</AccuracyLong>
			<RangedWeapon_Cooldown>2.5</RangedWeapon_Cooldown>
			<DeteriorationRate>0</DeteriorationRate>
			<Mass>20</Mass>
			<Flammability>0</Flammability>
		</statBases>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<defaultProjectile>Slorg_BeamBolt</defaultProjectile>
				<warmupTime>0</warmupTime>
				<range>28</range>
				<burstShotCount>2</burstShotCount>
				<ticksBetweenBurstShots>10</ticksBetweenBurstShots>
				<soundCast>ChargeLance_Fire</soundCast>
				<muzzleFlashScale>9</muzzleFlashScale>
			</li>
		</verbs>
	</ThingDef>

